# Región (país) que atiende ESTA instancia: CO | US | BR | FR | DE
REGION=CO
# Base de datos de ESTA región (Neon): cada país tiene la suya. Debe terminar en ?sslmode=require
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
PORT=4000
# Opcional: orígenes permitidos por CORS (vacío = todos)
CORS_ORIGIN=
# Opcional: fotos en Cloudinary (vacío = disco local backend/uploads)
CLOUDINARY_URL=
# Opcional: RabbitMQ (CloudAMQP gratis o local). Vacío = sin eventos
AMQP_URL=
